# -------------------------------------------------------------
# ThiranAI Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# -------------------------------------------------------------

# 1. Database Connection (Self-contained SQLite file - Zero external setup needed)
DATABASE_URL="file:./dev.db"

# 2. NextAuth Secret (Local Development Session Key)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="thiran-ai-super-secret-development-jwt-key-2026-safe-guard"

# 3. Google Gemini API Key
# Get your free API key in 30 seconds from Google AI Studio: https://aistudio.google.com/
# (If left blank, the app will automatically run in high-fidelity offline simulation mode)
GEMINI_API_KEY=""

# 4. Optional: Google OAuth Provider (Optional for testing)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
