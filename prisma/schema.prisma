// Prisma Schema for ThiranAI (Self-contained SQLite for local dev & easily switchable to PostgreSQL for production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  passwordHash        String?
  image               String?
  role                String               @default("STUDENT") // STUDENT, ADMIN, MENTOR
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  profile             Profile?
  aptitudeResults     AptitudeTestResult[]
  roadmaps            Roadmap[]
  assessments         Assessment[]
  mentorSessions      MentorSession[]
  notifications       Notification[]
  domainChangeLogs    DomainChangeLog[]
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetDomain        String?  // e.g. "Full-Stack Web Development", "AI & Machine Learning"
  experienceLevel     String   @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  bio                 String?
  skills              String   @default("[]") // JSON string: Array of { name: string, level: string, verified: boolean }
  projects            String   @default("[]") // JSON string: Array of { title: string, description: string, techStack: string[], link?: string }
  domainInterests     String   @default("[]") // JSON string: Array of string tags
  githubUrl           String?
  linkedinUrl         String?
  resumeText          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AptitudeTestResult {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers             String   // JSON string
  analyzedDomains     String   // JSON string: Ranked candidate domains
  selectedDomain      String?
  reasoning           String?
  createdAt           DateTime @default(now())
}

model Roadmap {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain              String
  title               String
  description         String?
  isCurrent           Boolean            @default(true)
  generatedByAi       Boolean            @default(true)
  completionPercent   Float              @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  milestones          RoadmapMilestone[]
}

model RoadmapMilestone {
  id                  String    @id @default(cuid())
  roadmapId           String
  roadmap             Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  orderIndex          Int
  title               String
  description         String
  whyItMatters        String
  estimatedHours      Int       @default(10)
  resources           String    // JSON string: Array of { title: string, url: string, type: 'video' | 'doc' | 'course', provider: string }
  practicalChallenge  String?   // JSON string: { challenge: string, deliverables: string[] }
  status              String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  completionPercent   Float     @default(0)
  submissionDetails   String?   // JSON string: { projectUrl: string, notes: string, completedAt: string }
  userRating          Int?      // 1-5 rating
  userFeedback        String?   // Reflection feedback
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Assessment {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneId         String?
  domain              String
  title               String
  questions           String   // JSON string
  userSubmission      String   // JSON string
  aiFeedback          String   // JSON string
  score               Float    // 0 to 100
  isPassed            Boolean  @default(true)
  createdAt           DateTime @default(now())
}

model HackathonListing {
  id                  String   @id @default(cuid())
  title               String
  organizer           String
  domainTags          String   // JSON string: string[]
  description         String
  startDate           DateTime
  endDate             DateTime
  deadline            DateTime
  location            String
  isOnline            Boolean  @default(true)
  registrationUrl     String
  prizePool           String?
  eligibilityCriteria String   // JSON string
  isCurated           Boolean  @default(true)
  createdAt           DateTime @default(now())
}

model InternshipListing {
  id                  String   @id @default(cuid())
  title               String
  company             String
  domain              String
  stipend             String
  location            String
  remote              Boolean  @default(false)
  applicationUrl      String
  deadline            DateTime
  description         String
  eligibilityCriteria String   // JSON string
  requiredSkills      String   // JSON string
  isCurated           Boolean  @default(true)
  createdAt           DateTime @default(now())
}

model MentorSession {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String          @default("Career Mentorship Session")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  messages            MentorMessage[]
}

model MentorMessage {
  id                  String        @id @default(cuid())
  sessionId           String
  session             MentorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role                String        // user, assistant, system
  content             String
  metadata            String?       // JSON string
  createdAt           DateTime      @default(now())
}

model Notification {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  message             String
  type                String   @default("SYSTEM") // MILESTONE, DEADLINE, ENCOURAGEMENT, DIVERSION, SYSTEM
  read                Boolean  @default(false)
  linkUrl             String?
  createdAt           DateTime @default(now())
}

model DomainChangeLog {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousDomain      String
  newDomain           String
  reason              String?
  switchedAt          DateTime @default(now())
}
